SECRET_KEY=your_django_secret_key_here
DEBUG=True

# Database Configuration
PLATFORM_DB_NAME=your_db_name
PLATFORM_DB_USER=your_db_user
PLATFORM_DB_PASSWORD=your_db_password
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=3306

FEE_DB_NAME=your_db_name
FEE_DB_USER=your_db_user
FEE_DB_PASSWORD=your_db_password
FEE_DB_HOST=localhost
FEE_DB_PORT=3306

CA_TOOLS_DB_NAME=your_db_name
CA_TOOLS_DB_USER=your_db_user
CA_TOOLS_DB_PASSWORD=your_db_password
CA_TOOLS_DB_HOST=localhost
CA_TOOLS_DB_PORT=3306

HIRELENS_DB_NAME=your_db_name
HIRELENS_DB_USER=your_db_user
HIRELENS_DB_PASSWORD=your_db_password
HIRELENS_DB_HOST=localhost
HIRELENS_DB_PORT=3306

# Allowed Hosts & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery (Optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SMTP Configuration (Optional if using EmailJS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7

# Gemini API (For Hirelens Question Generation)
GEMINI_API_KEY=your_gemini_api_key_here
